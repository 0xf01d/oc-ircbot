{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "memory/MEMORY.md"
  ],
  "compaction": {
    "auto": true,
    "prune": true,
    "tail_turns": 8
  },
  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "edit": {
      "**": "allow",
      "/data/secrets/**": "deny"
    },
    "write": {
      "**": "allow",
      "/data/secrets/**": "deny"
    },
    "bash": "allow",
    "webfetch": "allow",
    "task": "allow",
    "external_directory": "allow"
  }
}