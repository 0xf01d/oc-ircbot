{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["memory/MEMORY.md"],
  "compaction": {
    "auto": true,
    "prune": true,
    "tail_turns": 8
  },
  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "edit": {
      "**": "deny",
      "memory/**": "allow"
    },
    "write": {
      "**": "deny",
      "memory/**": "allow"
    },
    "bash": "deny",
    "webfetch": "deny",
    "task": "deny",
    "external_directory": "deny"
  }
}
