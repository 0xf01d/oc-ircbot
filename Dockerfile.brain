# brain image — OpenCode monitor stand-in. Needs Python (stdlib supervisor)
# and the Node-based OpenCode CLI.
FROM node:22-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends python3 ca-certificates \
 && rm -rf /var/lib/apt/lists/*

# The OpenCode CLI (Node package). Pulls its own binary at install time.
RUN npm install -g opencode-ai

WORKDIR /app
COPY brain.py ./
# tests/ ships the stub brain (OC_BRAIN_CMD) so the image is smoke-testable.
COPY tests/ ./tests/

RUN mkdir -p /data
ENV BOT_EVENTS=/data/events.log \
    BOT_FIFO=/data/bot.send \
    BRAIN_HEARTBEAT=/data/brain.heartbeat \
    BRAIN_MODEL=opencode/deepseek-v4.1-flash-free

CMD ["python3", "-u", "brain.py"]
